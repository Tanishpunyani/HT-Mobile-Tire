generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String?    @default("Customer")
  firstName String?    @map("first_name")
  lastName  String?    @map("last_name")
  email     String     @unique
  phone     String?
  role      String     @default("customer")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  customers Customer[]

  @@map("users")
}

model Service {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String             @unique
  slug              String             @unique
  description       String?
  price             Decimal?           @map("price") @db.Decimal(10, 2)
  depositAmount     Decimal?           @default(0.00) @map("deposit_amount") @db.Decimal(10, 2)
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bookings          Booking[]
  emergencyRequests EmergencyRequest[]

  @@map("services")
}

model Customer {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String?            @map("user_id") @db.Uuid
  name              String
  phone             String
  email             String?
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bookings          Booking[]
  user              User?              @relation(fields: [userId], references: [id], onUpdate: NoAction)
  emergencyRequests EmergencyRequest[]
  reviews           Review[]

  @@index([userId])
  @@index([phone])
  @@map("customers")
}

model Booking {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId       String?             @map("customer_id") @db.Uuid
  serviceId        String?             @map("service_id") @db.Uuid
  technicianId     String?             @map("technician_id") @db.Uuid
  primaryService   String              @default("Flat Tire Repair") @map("primary_service")
  extraServices    Json?               @map("extra_services") // Array of { name: string, price: number }
  vehicle          String
  location         String
  formattedAddress String?             @map("formatted_address")
  latitude         Float?              @map("latitude")
  longitude        Float?              @map("longitude")
  city             String?
  state            String?
  zipCode          String?             @map("zip_code")
  tireSize         String?             @map("tire_size")
  bookingDate      DateTime            @map("booking_date") @db.Date
  bookingTime      DateTime            @map("booking_time") @db.Time(6)
  message          String?
  notes            String?
  status           String              @default("pending") // pending, confirmed, in_progress, completed, cancelled
  paymentStatus    String              @default("pending") @map("payment_status") // pending, quote_sent, paid
  totalAmount      Decimal?            @map("total_amount") @db.Decimal(10, 2)
  serviceConfirmedAt       DateTime?   @map("service_confirmed_at") @db.Timestamptz(6)
  arrivedAt                DateTime?   @map("arrived_at") @db.Timestamptz(6)
  estimatedDurationMinutes Int?        @default(45) @map("estimated_duration_minutes")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer         Customer?           @relation(fields: [customerId], references: [id], onUpdate: NoAction)
  service          Service?            @relation(fields: [serviceId], references: [id], onUpdate: NoAction)
  technician       Technician?         @relation(fields: [technicianId], references: [id], onUpdate: NoAction)
  reviews          Review[]
  technicianLocation TechnicianLocation?

  @@index([customerId])
  @@index([serviceId])
  @@index([technicianId])
  @@index([status])
  @@index([bookingDate])
  @@map("bookings")
}

model EmergencyRequest {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId       String?   @map("customer_id") @db.Uuid
  serviceId        String?   @map("service_id") @db.Uuid
  currentLocation  String    @map("current_location")
  formattedAddress String?   @map("formatted_address")
  latitude         Float?    @map("latitude")
  longitude        Float?    @map("longitude")
  city             String?
  state            String?
  zipCode          String?   @map("zip_code")
  problem          String
  problemDetails   String?   @map("problem_details")
  vehicle          String
  status           String    @default("pending")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer         Customer? @relation(fields: [customerId], references: [id], onUpdate: NoAction)
  service          Service?  @relation(fields: [serviceId], references: [id], onUpdate: NoAction)

  @@index([customerId])
  @@index([serviceId])
  @@index([status])
  @@map("emergency_requests")
}

model ContactMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  phone     String
  email     String?
  service   String?
  location  String?
  emergency Boolean  @default(false)
  message   String?
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("contact_messages")
}

model Review {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String?   @map("customer_id") @db.Uuid
  bookingId  String?   @map("booking_id") @db.Uuid
  rating     Int
  review     String    @db.Text
  comment    String?   @db.Text
  isApproved Boolean   @default(false) @map("is_approved")
  rejectedAt DateTime? @map("rejected_at") @db.Timestamptz(6)
  adminNotes String?   @map("admin_notes") @db.Text
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  booking    Booking?  @relation(fields: [bookingId], references: [id], onUpdate: NoAction)
  customer   Customer? @relation(fields: [customerId], references: [id], onUpdate: NoAction)

  @@map("reviews")
}

model NotificationLog {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId          String?   @map("booking_id") @db.Uuid
  emergencyRequestId String?   @map("emergency_request_id") @db.Uuid
  entityId           String?   @map("entity_id") @db.Uuid
  entityType         String?   @map("entity_type")
  type               String    // "SMS" | "EMAIL" | "booking_confirmation" | "emergency_alert" | "status_update" | "quote_sent"
  channel            String?   // "sms" | "email"
  status             String    @default("PENDING") // "SENT" | "FAILED" | "PENDING"
  recipient          String
  content            String?   @db.Text
  subject            String?
  body               String?   @db.Text
  errorMessage       String?   @map("error_message") @db.Text
  retryCount         Int       @default(0) @map("retry_count")
  messageId          String?   @map("message_id")
  deliveryStatus     String?   @map("delivery_status") // "DELIVERED" | "FAILED" | "CANCELLED"
  deliveredAt        DateTime? @map("delivered_at") @db.Timestamptz(6)
  providerEventId    String?   @map("provider_event_id")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([createdAt, status])
  @@index([messageId])
  @@map("notification_logs")
}

model BookingDraft {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String?   @map("user_id") @db.Uuid
  customerId       String?   @map("customer_id") @db.Uuid
  serviceId        String?   @map("service_id") @db.Uuid
  customerName     String    @map("customer_name")
  customerPhone    String    @map("customer_phone")
  customerEmail    String?   @map("customer_email")
  serviceName      String    @map("service_name")
  vehicle          String
  location         String
  formattedAddress String?   @map("formatted_address")
  latitude         Float?    @map("latitude")
  longitude        Float?    @map("longitude")
  city             String?
  state            String?
  zipCode          String?   @map("zip_code")
  tireSize         String?   @map("tire_size")
  bookingDate      DateTime  @map("booking_date") @db.Date
  bookingTime      DateTime  @map("booking_time") @db.Time(6)
  message          String?
  status           String    @default("draft")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("booking_drafts")
}

model Technician {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String               @unique
  role                String               @default("Mobile Tire Technician")
  phone               String?
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bookings            Booking[]
  technicianLocations TechnicianLocation[]

  @@map("technicians")
}

model TechnicianLocation {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId    String      @unique @map("booking_id") @db.Uuid
  technicianId String?     @map("technician_id") @db.Uuid
  latitude     Float
  longitude    Float
  heading      Float?
  speed        Float?
  isActive     Boolean     @default(true) @map("is_active")
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  booking      Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  technician   Technician? @relation(fields: [technicianId], references: [id], onDelete: SetNull)

  @@index([technicianId])
  @@map("technician_locations")
}

model AdminSession {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([token])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model AdminLoginAttempt {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key            String    @unique
  attemptCount   Int       @default(1) @map("attempt_count")
  firstAttemptAt DateTime  @default(now()) @map("first_attempt_at") @db.Timestamptz(6)
  lastAttemptAt  DateTime  @default(now()) @updatedAt @map("last_attempt_at") @db.Timestamptz(6)
  blockedUntil   DateTime? @map("blocked_until") @db.Timestamptz(6)

  @@index([key])
  @@index([blockedUntil])
  @@map("admin_login_attempts")
}

