# =============================================================================
# MOBILE TIRE CLINIC — ENVIRONMENT CONFIGURATION TEMPLATE
# (Quote-Based Pricing & Dispatch System)
# =============================================================================

# Canonical public application URL (used for sitemap, robots, metadata, and notification links).
# In production, set to your verified public domain (e.g. "https://ht-mobile-tire.vercel.app").
# Automatically falls back to "https://ht-mobile-tire.vercel.app" if unset or invalid.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BUSINESS_PHONE="+16479956665"
NEXT_PUBLIC_BUSINESS_PHONE_DISPLAY="+1 (647) 995-6665"

# -----------------------------------------------------------------------------
# SUPABASE & DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
DATABASE_URL="postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:5432/postgres"

# Central dispatch or technician phone number to receive job alerts
TECHNICIAN_PHONE_NUMBER="+1XXXXXXXXXX"
TECHNICIAN_API_KEY="your-secure-random-technician-api-key"
TECHNICIAN_DISPATCH_SECRET="your-secure-random-technician-dispatch-secret-hmac-sha256"

# -----------------------------------------------------------------------------
# RESEND EMAIL NOTIFICATION CONFIGURATION (For Branded Quotes & PDF Invoices)
# -----------------------------------------------------------------------------
# Get from Resend Dashboard: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Verified sender email address in Resend.
# In local/sandbox development or prior to custom domain verification, use 'onboarding@resend.dev'.
# NOTE: Changing to a custom domain sender requires DNS verification (SPF, DKIM, DMARC) in Resend after purchasing the domain.
RESEND_FROM_EMAIL="HT Mobile Tire <onboarding@resend.dev>"
FROM_EMAIL="HT Mobile Tire <onboarding@resend.dev>"

# -----------------------------------------------------------------------------
# ADDRESS AUTOCOMPLETE & MAPS API
# -----------------------------------------------------------------------------
# SerpApi Google Autocomplete (Server-side proxy for customer address lookup)
SERPAPI_API_KEY="your-serpapi-api-key"
# Optional search location for SerpApi autocomplete (defaults to Greater Toronto Area "@43.6532,-79.3832,14z")
SERPAPI_AUTOCOMPLETE_LL="@43.6532,-79.3832,14z"

# Google Static Maps & Geocoding (Optional server fallbacks for dispatch & navigation)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GOOGLE_MAPS_SERVER_API_KEY="AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"


# -----------------------------------------------------------------------------
# ADMIN & CRON SECURITY
# -----------------------------------------------------------------------------
ADMIN_EMAIL="admin@mobiletire.clinic"
ADMIN_PASSWORD_HASH="$2a$12$example-bcrypt-hash-not-a-real-secret"
CRON_SECRET="your-secure-random-cron-secret-for-retries"
